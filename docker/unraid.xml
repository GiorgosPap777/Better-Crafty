<?xml version="1.0"?>
<Container version="2">
  <Name>Better-Crafty</Name>
  <Repository>giorgospap777/better-crafty</Repository>
  <Registry>https://hub.docker.com/r/giorgospap777/better-crafty</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/GiorgosPap777/Better-Crafty/issues</Support>
  <Project>https://github.com/GiorgosPap777/Better-Crafty</Project>
  <Overview>Better Crafty is a fork of Crafty Controller 4.11.0, the web control panel for Minecraft servers, with a reworked login screen, easier server management pages and a long list of bug and security fixes.&#xD;
&#xD;
Terminal with command suggestions like the game's chat box, server.properties and memory as normal form fields, players with their inventories and statistics, clearer backups with copies to another disk, a network share or S3-compatible cloud storage, and world tools.&#xD;
&#xD;
 **The first login's password is in the file default-creds.txt in the Crafty Configuration folder.**  &#xD;
&#xD;
Not made by or affiliated with the Crafty Controller team. Questions and bugs: https://github.com/GiorgosPap777/Better-Crafty/issues</Overview>
  <Category>GameServers: Other:</Category>
  <WebUI>https://[IP]:[PORT:8443]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/GiorgosPap777/Better-Crafty/HEAD/docker/unraid.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/GiorgosPap777/Better-Crafty/HEAD/app/frontend/static/assets/images/crafty-logo-square-96.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Web UI Port" Target="8443" Default="8443" Mode="tcp" Description="Web UI [HTTPS]" Type="Port" Display="always-hide" Required="true" Mask="false">8443</Config>
  <Config Name="Minecraft ports" Target="25500-25600" Default="25500-25600" Mode="tcp" Description="TCP Ports for Minecraft" Type="Port" Display="always-hide" Required="true" Mask="false">25500-25600</Config>
  <Config Name="Port for dynmap" Target="8123" Default="8123" Mode="tcp" Description="Dynmap Port" Type="Port" Display="always-hide" Required="true" Mask="false">8123</Config>
  <Config Name="Port for bedrock server" Target="19132" Default="19132" Mode="udp" Description="Bedrock server port" Type="Port" Display="always-hide" Required="true" Mask="false">19132</Config>
  <Config Name="Server files" Target="/crafty/servers" Default="/mnt/user/appdata/better-crafty/servers/" Mode="rw" Description="Path to the minecraft server folders" Type="Path" Display="always-hide" Required="true" Mask="false">/mnt/user/appdata/better-crafty/servers/</Config>
  <Config Name="Backup files" Target="/crafty/backups" Default="/mnt/user/appdata/better-crafty/backups/" Mode="rw" Description="Server Backups" Type="Path" Display="always-hide" Required="true" Mask="false">/mnt/user/appdata/better-crafty/backups/</Config>
  <Config Name="Hytale Ports" Target="5520-5550" Default="" Mode="udp" Description="UDP Ports for Hytale" Type="Port" Display="always-hide" Required="true" Mask="false">5520-5550</Config>
  <Config Name="Server Logs" Target="/crafty/logs" Default="/mnt/user/appdata/better-crafty/logs/" Mode="rw" Description="Logs" Type="Path" Display="advanced-hide" Required="true" Mask="false">/mnt/user/appdata/better-crafty/logs/</Config>
  <Config Name="Crafty Configuration" Target="/crafty/app/config" Default="/mnt/user/appdata/better-crafty/config/" Mode="rw" Description="Path to the persistent Crafty files" Type="Path" Display="advanced-hide" Required="true" Mask="false">/mnt/user/appdata/better-crafty/config/</Config>
  <Config Name="Import folder" Target="/crafty/import" Default="/mnt/user/appdata/better-crafty/import/" Mode="rw" Description="Import existing Minecraft servers" Type="Path" Display="advanced-hide" Required="true" Mask="false">/mnt/user/appdata/better-crafty/import/</Config>
  <TailscaleStateDir/>
</Container>